#!/bin/bash
# One long-running podman container per repo, for Claude Code sessions and
# for anything that shouldn't run on the Mac itself (servers, downloads,
# arbitrary scripts).
#
#   claude-pod [claude args...]   claude, inside the repo's container
#   claude-pod exec 'cmd ...'     run cmd (zsh -c) inside the repo's container
#   claude-pod up                 start the container if needed (exec/claude do this)
#   claude-pod down               stop + remove it (servers, downloads, installs gone)
#   claude-pod ports              which pod each localhost port points at
#   claude-pod claim [port...]    point localhost:port at THIS repo's pod, taking
#                                 it from another pod if need be (no ports: every
#                                 port this pod is listening on)
#   claude-pod --build            (re)build the image, e.g. to update claude
#
#   CLAUDE_POD_MODE=acceptEdits claude-pod    permission mode (default: auto);
#                                             bypassPermissions = no prompts
#   CLAUDE_POD_GIT_RW=1 claude-pod up         .git writable (default: r/o)
#   CLAUDE_POD_NET=open claude-pod up         no egress filter (default: https only)
#
# Network: outbound is HTTPS ONLY by default -- TCP/UDP 443, plus DNS to the
# container's own resolvers (podman's forwarders, so lookups use the Mac's
# resolver) and replies on connections made INTO the container (published
# ports). Everything else, plain http :80 included, is rejected at once. The
# rules are installed by container-root at start; Claude runs as your uid with
# no capabilities and no-new-privileges, so it cannot remove them.
#
# Mounts, all at their real Mac paths (so absolute paths and the
# project-keyed session history line up with host sessions):
#   the current repo            r/w  except .git .claude .vscode: r/o, since
#                                    host-side git/claude/vscode EXECUTE what
#                                    those contain
#   each dir in $CLAUDE_PODS    r/o  (required; SPACE separated, eg:
#                                    export CLAUDE_PODS="$HOME/dev $HOME/repo")
#   ~/.claude-pod               r/w  as CLAUDE_CONFIG_DIR: login, MCP config,
#                                    sessions, memory. Never your ~/.claude.
#
# Those dirs must also be shared into the podman machine (podman machine
# init -v ...); a repo anywhere else is invisible to the VM, so we refuse.
#
# Ports: repo pods publish nothing themselves, so they always start. They
# all join the "claude-pod" podman network, and one small proxy container
# (claude-pod-proxy) publishes the usual ports at the SAME port on the Mac
# -- hugo's 1313 is http://localhost:1313 -- forwarding each one (socat) to
# whichever pod last claimed it. Servers inside use their usual defaults,
# just --bind 0.0.0.0 (a 127.0.0.1-only server can't be forwarded to).
#   - After every `exec`, ports this pod listens on are claimed when free:
#     unclaimed, or the pod holding it is no longer listening there.
#   - `claim` also takes ports from a pod that IS still listening. That
#     pod's server keeps running; it just stops getting the traffic.
# Claims are kept in claude-pod.routes beside this script, outside every
# mount, so no container can rewrite them (deleting it only drops claims).
# A port in use on the Mac when the proxy is (re)created is skipped.
#
# Names: a repo's pod is claude-<repo dir name>, eg: claude-petabox, and a
# second clone in petabox2/ is claude-petabox2. Each pod is labelled with its
# repo's full path, so a same-named dir somewhere else is refused rather
# than handed the other clone's pod (and its r/w mount).
set -euo pipefail

IMAGE=localhost/claude-pod
# the real dir, even when run via a symlink on PATH (eg: ~/bin/claude-pod)
SELF=$0
while [ -L "$SELF" ]; do
  link=$(readlink "$SELF")
  case "$link" in /*) SELF=$link ;; *) SELF=$(dirname "$SELF")/$link ;; esac
done
HERE=$(cd "$(dirname "$SELF")" && pwd)
ROUTES=$HERE/claude-pod.routes
CONF=$HOME/.claude-pod
read -ra RO_DIRS <<< "${CLAUDE_PODS:?set to a SPACE separated string of dirs that can be read}"
MODE=${CLAUDE_POD_MODE:-auto}
NET=claude-pod
PROXY=claude-pod-proxy
# ports the proxy publishes on the Mac (127.0.0.1 only), each at the same number,
# except below 1024: macOS won't let podman's unprivileged gvproxy bind those to
# 127.0.0.1, so 80 is localhost:10080 and 443 is localhost:10443
CPORTS=(80 443 1313 3000 4000 4321 5000 5173 8000 8080 8888 9000)

host_port() { if [ "$1" -lt 1024 ]; then echo $(($1 + 10000)); else echo "$1"; fi; }

if [ "${1:-}" = --build ]; then
  exec podman build -t "$IMAGE" - < "$HERE/Containerfile"
fi

REPO=$(git rev-parse --show-toplevel 2>/dev/null || pwd)

ok=
for d in "${RO_DIRS[@]}"; do
  case "$REPO/" in "$d"/*) ok=1 ;; esac
done
[ "$ok" ] || { echo "claude-pod: $REPO is not under: ${RO_DIRS[*]}" >&2; exit 1; }

touch "$ROUTES"
# (only the characters podman allows in a name)
NAME=claude-$(basename "$REPO" | tr -c 'A-Za-z0-9_.\n-' _)
owner=$(podman inspect -f '{{index .Config.Labels "claude-pod.repo"}}' "$NAME" 2>/dev/null || true)
if podman container exists "$NAME" && [ "$owner" != "$REPO" ]; then
  echo "claude-pod: $NAME belongs to ${owner:-another repo}, not $REPO." >&2
  echo "claude-pod: rename one of the dirs (eg: ${REPO}2), or remove that pod: podman rm -f $NAME" >&2
  exit 1
fi

# "port address" for each TCP listener in pod $1 (nothing if it isn't running)
listeners() {
  podman exec "$1" netstat -ltn 2>/dev/null |
    awk '$NF == "LISTEN" { a = $4; p = a; sub(/.*:/, "", p); sub(/:[0-9]+$/, "", a); print p, a }' |
    sort -u || true
}

# ports pod $1 listens on that the proxy can reach (not loopback-only)
reachable() {
  listeners "$1" | awk '$2 !~ /^(127\.|::1$)/ { print $1 }' | sort -un
}

# ports the proxy actually publishes
published() {
  podman port "$PROXY" 2>/dev/null | awk -F'[/ ]' '{ print $1 }' | sort -un || true
}

route_of() { awk -v p="$1" '$1 == p { print $2 }' "$ROUTES"; }

# (re)start the proxy's forwarder for port $1 to pod $2
forward() {
  podman exec "$PROXY" pkill -f "^socat TCP-LISTEN:$1," || true
  podman exec -d "$PROXY" socat "TCP-LISTEN:$1,fork,reuseaddr" "TCP:$2:$1" >/dev/null
}

# point localhost:$1 at pod $2, and remember it
point() {
  forward "$1" "$2"
  { awk -v p="$1" '$1 != p' "$ROUTES"; echo "$1 $2"; } > "$ROUTES.new"
  mv "$ROUTES.new" "$ROUTES"
  echo "claude-pod: http://localhost:$(host_port "$1") -> $2:$1" >&2
}

proxy_up() {
  local want have p h args=()
  podman network exists "$NET" || podman network create "$NET" >/dev/null
  want="$(podman image inspect -f '{{.Id}}' "$IMAGE"):ports=${CPORTS[*]}:low=+10000"
  have=$(podman inspect -f '{{index .Config.Labels "claude-pod.spec"}}' "$PROXY" 2>/dev/null || true)
  if [ "$have" = "$want" ]; then
    [ "$(podman inspect -f '{{.State.Running}}' "$PROXY")" = true ] && return
    podman start "$PROXY" >/dev/null
  else
    [ -z "$have" ] || podman rm -f "$PROXY" >/dev/null
    for p in "${CPORTS[@]}"; do
      h=$(host_port "$p")
      if (exec 3<>"/dev/tcp/127.0.0.1/$h") 2>/dev/null; then
        echo "claude-pod: localhost:$h is in use on the Mac; the proxy skips it" >&2
      else
        args+=(-p "127.0.0.1:$h:$p")
      fi
    done
    # nothing runs in here but socat: no privileges, read-only root
    podman run -d \
      --name "$PROXY" \
      --label "claude-pod.spec=$want" \
      --network "$NET" \
      --init \
      --user 65534:65534 \
      --cap-drop all \
      --security-opt no-new-privileges \
      --sysctl net.ipv4.ip_unprivileged_port_start=0 \
      --read-only \
      "${args[@]}" \
      --entrypoint sleep \
      "$IMAGE" infinity >/dev/null
  fi
  # a fresh or restarted proxy has no forwarders yet: restore the claims
  local c
  while read -r p c; do
    [ -n "$c" ] && forward "$p" "$c"
  done < "$ROUTES"
}

# claim ports for this pod. $1: "steal" to take them from a pod still
# listening there, else only free ones. Rest: ports (none = all reachable).
claim() {
  local steal=$1 p owner pub listen
  shift
  pub=" $(published | tr '\n' ' ') "
  listen=" $(reachable "$NAME" | tr '\n' ' ') "
  if [ $# -eq 0 ]; then
    # shellcheck disable=SC2086
    set -- $listen
    [ "$steal" = steal ] && listeners "$NAME" | awk '$2 ~ /^(127\.|::1$)/ { print $1 }' | sort -u |
      while read -r p; do
        echo "claude-pod: :$p listens on loopback only -- bind 0.0.0.0 to forward it" >&2
      done
  fi
  for p in "$@"; do
    case "$pub" in *" $p "*) ;; *)
      [ "$steal" = steal ] && echo "claude-pod: the proxy does not publish $p (not in CPORTS, or busy on the Mac)" >&2
      continue ;;
    esac
    owner=$(route_of "$p")
    [ "$owner" = "$NAME" ] && continue
    if [ "$steal" != steal ] && [ -n "$owner" ] && reachable "$owner" | grep -qx "$p"; then
      continue
    fi
    [ "$steal" = steal ] && case "$listen" in *" $p "*) ;; *)
      echo "claude-pod: note: nothing in $NAME is listening on $p yet" >&2 ;;
    esac
    point "$p" "$NAME"
  done
}

ports() {
  local p owner mark target
  for p in $(published); do
    owner=$(route_of "$p")
    mark=
    [ "$owner" = "$NAME" ] && mark='  (this repo)'
    target=${owner:+$owner:$p}
    printf 'http://localhost:%-5s  ->  %s%s\n' "$(host_port "$p")" "${target:-(unclaimed)}" "$mark"
  done
}

# Egress filter (see the Network note at the top). Lives in the container's
# network namespace, which a restart replaces -- so it is installed on every
# start, not just at creation.
#
# NET_ADMIN only for THIS exec (--privileged), never on the container: a
# container-level --cap-add is handed to non-root processes too, which let
# the uid Claude runs as list and delete these very rules (found 2026-10-01).
net_rules() {
  [ "${CLAUDE_POD_NET:-}" = open ] && return
  podman exec -i --privileged -u 0 "$NAME" sh -c '
    ns4=$(awk "/^nameserver/ && \$2 !~ /:/ {print \$2}" /etc/resolv.conf | paste -sd, -)
    ns6=$(awk "/^nameserver/ && \$2 ~ /:/ {print \$2}" /etc/resolv.conf | paste -sd, -)
    {
      echo "table inet claude_pod {"
      echo "  chain out {"
      echo "    type filter hook output priority 0; policy drop;"
      echo "    oifname \"lo\" accept"
      echo "    ct state established,related accept"
      echo "    meta l4proto { icmp, ipv6-icmp } accept"
      [ -n "$ns4" ] && echo "    ip daddr { $ns4 } meta l4proto { tcp, udp } th dport 53 accept"
      [ -n "$ns6" ] && echo "    ip6 daddr { $ns6 } meta l4proto { tcp, udp } th dport 53 accept"
      echo "    meta l4proto { tcp, udp } th dport 443 accept"
      echo "    meta l4proto tcp reject with tcp reset"
      echo "    reject"
      echo "  }"
      echo "}"
    } > /tmp/claude-pod.nft
    nft delete table inet claude_pod 2>/dev/null
    nft -f /tmp/claude-pod.nft && rm /tmp/claude-pod.nft
  ' || { echo "claude-pod: could not install the egress filter; refusing to run unfiltered" >&2; podman stop "$NAME" >/dev/null; exit 1; }
}

up() {
  local want have
  proxy_up
  # recreate when the image was rebuilt, or the git/net mode changed
  want="$(podman image inspect -f '{{.Id}}' "$IMAGE"):git-rw=${CLAUDE_POD_GIT_RW:-}:net=${CLAUDE_POD_NET:-https}:network=$NET"
  have=$(podman inspect -f '{{index .Config.Labels "claude-pod.spec"}}' "$NAME" 2>/dev/null || true)
  if [ "$have" = "$want" ]; then
    if [ "$(podman inspect -f '{{.State.Running}}' "$NAME")" != true ]; then
      podman start "$NAME" >/dev/null
      net_rules
    fi
    return
  fi
  [ -z "$have" ] || { echo "claude-pod: image or git/net mode changed, recreating $NAME" >&2; podman rm -f "$NAME" >/dev/null; }

  mkdir -p "$CONF"
  local args=() d
  for d in "${RO_DIRS[@]}"; do
    # skip -- REPO gets its own, more specific rw mount below; same destination twice is a
    # podman error (not the "more specific wins" case just below, which is a nested path)
    [ "$d" = "$REPO" ] && continue
    [ -d "$d" ] && args+=(-v "$d:$d:ro")
  done
  # More specific mounts win, so these land on top of the r/o parents.
  args+=(-v "$REPO:$REPO:rw")
  [ -z "${CLAUDE_POD_GIT_RW:-}" ] && [ -d "$REPO/.git" ] && args+=(-v "$REPO/.git:$REPO/.git:ro")
  # Created if missing: an absent dir would otherwise be creatable, r/w.
  for d in .claude .vscode; do
    mkdir -p "$REPO/$d"
    args+=(-v "$REPO/$d:$REPO/$d:ro")
  done
  args+=(-v "$CONF:$CONF:rw")

  podman run -d \
    --name "$NAME" \
    --label "claude-pod.spec=$want" \
    --label "claude-pod.repo=$REPO" \
    --hostname "$NAME" \
    --network "$NET" \
    --init \
    --userns=keep-id \
    --security-opt no-new-privileges \
    --sysctl net.ipv4.ip_unprivileged_port_start=0 \
    "${args[@]}" \
    -w "$REPO" \
    -e HOME=/home/claude \
    -e CLAUDE_CONFIG_DIR="$CONF" \
    -e GIT_OPTIONAL_LOCKS=0 \
    -e CLAUDE_POD_PORTS="servers bound to 0.0.0.0 here show on the Mac at http://localhost:<same port>, once claimed for this pod (host side: claude-pod claim)" \
    --entrypoint sleep \
    "$IMAGE" infinity >/dev/null
  net_rules
}

# -t only with a terminal, so Claude's Bash tool (no tty) can use exec too
tty_flags() {
  local f=
  [ -t 0 ] && f+=' -i'
  [ -t 1 ] && f+=' -t'
  echo "$f"
}

case "${1:-}" in
  up)    up ;;
  down)  podman rm -f "$NAME" >/dev/null 2>&1 || true ;;
  ports) proxy_up; ports ;;
  claim)
    shift
    up
    claim steal "$@"
    ports
    ;;
  exec)
    shift
    up
    rc=0
    # shellcheck disable=SC2046
    podman exec $(tty_flags) -w "$PWD" \
      -e TERM="${TERM:-xterm-256color}" \
      "$NAME" zsh -c "$*" || rc=$?
    # pick up any server the command started, if its port is free
    claim free || true
    exit "$rc"
    ;;
  *)
    up
    exec podman exec -it -w "$PWD" \
      -e TERM="${TERM:-xterm-256color}" \
      -e COLORTERM="${COLORTERM:-}" \
      "$NAME" claude --permission-mode "$MODE" "$@"
    ;;
esac
