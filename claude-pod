#!/bin/bash
# One long-running podman container per repo, for Claude Code sessions and
# for anything that shouldn't run on the Mac itself (servers, downloads,
# arbitrary scripts).
#
#   claude-pod [claude args...]   claude, inside the repo's container
#   claude-pod exec 'cmd ...'     run cmd (zsh -c) inside the repo's container
#   claude-pod up                 start the container if needed (exec/claude do this)
#   claude-pod down               stop + remove it (servers, downloads, installs gone)
#   claude-pod ports              this repo's fixed host ports
#   claude-pod --build            (re)build the image, e.g. to update claude
#
#   CLAUDE_POD_MODE=acceptEdits claude-pod    permission mode (default: auto);
#                                             bypassPermissions = no prompts
#   CLAUDE_POD_GIT_RW=1 claude-pod up         .git writable (default: r/o)
#   CLAUDE_POD_NET=open claude-pod up         no egress filter (default: https only)
#
# Network: outbound is HTTPS ONLY by default -- TCP/UDP 443, plus DNS to the
# container's own resolvers (podman's forwarders, so lookups use the Mac's
# resolver) and replies on connections made INTO the container (published
# ports). Everything else, plain http :80 included, is rejected at once. The
# rules are installed by container-root at start; Claude runs as your uid with
# no capabilities and no-new-privileges, so it cannot remove them.
#
# Mounts, all at their real Mac paths (so absolute paths and the
# project-keyed session history line up with host sessions):
#   the current repo            r/w  except .git .claude .vscode: r/o, since
#                                    host-side git/claude/vscode EXECUTE what
#                                    those contain
#   each dir in $CLAUDE_PODS    r/o  (required; SPACE separated, eg:
#                                    export CLAUDE_PODS="$HOME/dev $HOME/repo")
#   ~/.claude-pod               r/w  as CLAUDE_CONFIG_DIR: login, MCP config,
#                                    sessions, memory. Never your ~/.claude.
#
# Those dirs must also be shared into the podman machine (podman machine
# init -v ...); a repo anywhere else is invisible to the VM, so we refuse.
#
# Ports: each repo gets a fixed digit N, and container port P is published
# at host port N*10000 + P -- so hugo's 1313 is 21313 for repo 2, 31313 for
# repo 3. Digits 1-5 fit every P below 10000; 6 only fits P <= 5535 (larger
# ones are skipped). The digit is assigned on first use and recorded in
# claude-pod.ports beside this script -- outside every mount, so no
# container can rewrite it. Hand-edit it freely (with the container down).
# Servers inside use their usual defaults, just --bind 0.0.0.0 where needed.
set -euo pipefail

IMAGE=localhost/claude-pod
HERE=$(cd "$(dirname "$0")" && pwd)
REGISTRY=$HERE/claude-pod.ports
CONF=$HOME/.claude-pod
read -ra RO_DIRS <<< "${CLAUDE_PODS:?set to a SPACE separated string of dirs that can be read}"
MODE=${CLAUDE_POD_MODE:-auto}
# container ports to publish, each at host port DIGIT*10000 + port
CPORTS=(80 443 1313 3000 4000 5173 8000 8080 8888 9000)
DIGITS=(2 3 4 5 1 6)   # assignment order: 2 first, per Tracey's mnemonic

if [ "${1:-}" = --build ]; then
  exec podman build -t "$IMAGE" - < "$HERE/Containerfile"
fi

REPO=$(git rev-parse --show-toplevel 2>/dev/null || pwd)

ok=
for d in "${RO_DIRS[@]}"; do
  case "$REPO/" in "$d"/*) ok=1 ;; esac
done
[ "$ok" ] || { echo "claude-pod: $REPO is not under: ${RO_DIRS[*]}" >&2; exit 1; }

# registry line: "<digit> <repo path>"
touch "$REGISTRY"
DIGIT=$(awk -v r="$REPO" '{ d = $1; sub(/^[0-9]+ /, ""); if ($0 == r) print d }' "$REGISTRY")
if [ -z "$DIGIT" ]; then
  for d in "${DIGITS[@]}"; do
    awk -v d="$d" '$1 == d { found = 1 } END { exit !found }' "$REGISTRY" || { DIGIT=$d; break; }
  done
  [ "$DIGIT" ] || { echo "claude-pod: all port digits taken -- free one in $REGISTRY" >&2; exit 1; }
  echo "$DIGIT $REPO" >> "$REGISTRY"
fi
# digit in the name: unique even for two repos with the same basename
NAME=claude-$(basename "$REPO")-$DIGIT

# "container-port host-port" pairs that fit under 65536
port_pairs() {
  local p
  for p in "${CPORTS[@]}"; do
    [ $((DIGIT * 10000 + p)) -le 65535 ] && echo "$p $((DIGIT * 10000 + p))"
  done
}

ports() {
  local p h
  port_pairs | while read -r p h; do
    printf '%5s  ->  http://localhost:%s\n' "$p" "$h"
  done
}

# Egress filter (see the Network note at the top). Lives in the container's
# network namespace, which a restart replaces -- so it is installed on every
# start, not just at creation.
#
# NET_ADMIN only for THIS exec (--privileged), never on the container: a
# container-level --cap-add is handed to non-root processes too, which let
# the uid Claude runs as list and delete these very rules (found 2026-10-01).
net_rules() {
  [ "${CLAUDE_POD_NET:-}" = open ] && return
  podman exec -i --privileged -u 0 "$NAME" sh -c '
    ns4=$(awk "/^nameserver/ && \$2 !~ /:/ {print \$2}" /etc/resolv.conf | paste -sd, -)
    ns6=$(awk "/^nameserver/ && \$2 ~ /:/ {print \$2}" /etc/resolv.conf | paste -sd, -)
    {
      echo "table inet claude_pod {"
      echo "  chain out {"
      echo "    type filter hook output priority 0; policy drop;"
      echo "    oifname \"lo\" accept"
      echo "    ct state established,related accept"
      echo "    meta l4proto { icmp, ipv6-icmp } accept"
      [ -n "$ns4" ] && echo "    ip daddr { $ns4 } meta l4proto { tcp, udp } th dport 53 accept"
      [ -n "$ns6" ] && echo "    ip6 daddr { $ns6 } meta l4proto { tcp, udp } th dport 53 accept"
      echo "    meta l4proto { tcp, udp } th dport 443 accept"
      echo "    meta l4proto tcp reject with tcp reset"
      echo "    reject"
      echo "  }"
      echo "}"
    } > /tmp/claude-pod.nft
    nft delete table inet claude_pod 2>/dev/null
    nft -f /tmp/claude-pod.nft && rm /tmp/claude-pod.nft
  ' || { echo "claude-pod: could not install the egress filter; refusing to run unfiltered" >&2; podman stop "$NAME" >/dev/null; exit 1; }
}

up() {
  local want have
  # recreate when the image was rebuilt, or the git/net mode or ports changed
  want="$(podman image inspect -f '{{.Id}}' "$IMAGE"):git-rw=${CLAUDE_POD_GIT_RW:-}:net=${CLAUDE_POD_NET:-https}:ports=$(port_pairs | tr '\n ' ',:')"
  have=$(podman inspect -f '{{index .Config.Labels "claude-pod.spec"}}' "$NAME" 2>/dev/null || true)
  if [ "$have" = "$want" ]; then
    if [ "$(podman inspect -f '{{.State.Running}}' "$NAME")" != true ]; then
      podman start "$NAME" >/dev/null
      net_rules
    fi
    return
  fi
  [ -z "$have" ] || { echo "claude-pod: image or git mode changed, recreating $NAME" >&2; podman rm -f "$NAME" >/dev/null; }

  mkdir -p "$CONF"
  local args=() d p h
  for d in "${RO_DIRS[@]}"; do
    # skip -- REPO gets its own, more specific rw mount below; same destination twice is a
    # podman error (not the "more specific wins" case just below, which is a nested path)
    [ "$d" = "$REPO" ] && continue
    [ -d "$d" ] && args+=(-v "$d:$d:ro")
  done
  # More specific mounts win, so these land on top of the r/o parents.
  args+=(-v "$REPO:$REPO:rw")
  [ -z "${CLAUDE_POD_GIT_RW:-}" ] && [ -d "$REPO/.git" ] && args+=(-v "$REPO/.git:$REPO/.git:ro")
  # Created if missing: an absent dir would otherwise be creatable, r/w.
  for d in .claude .vscode; do
    mkdir -p "$REPO/$d"
    args+=(-v "$REPO/$d:$REPO/$d:ro")
  done
  args+=(-v "$CONF:$CONF:rw")
  while read -r p h; do
    args+=(-p "127.0.0.1:$h:$p")
  done < <(port_pairs)

  podman run -d \
    --name "$NAME" \
    --label "claude-pod.spec=$want" \
    --hostname "$NAME" \
    --init \
    --userns=keep-id \
    --security-opt no-new-privileges \
    --sysctl net.ipv4.ip_unprivileged_port_start=0 \
    "${args[@]}" \
    -w "$REPO" \
    -e HOME=/home/claude \
    -e CLAUDE_CONFIG_DIR="$CONF" \
    -e GIT_OPTIONAL_LOCKS=0 \
    -e CLAUDE_POD_PORTS="$(ports | tr -s ' ' | tr '\n' ';')" \
    --entrypoint sleep \
    "$IMAGE" infinity >/dev/null
  net_rules
}

# -t only with a terminal, so Claude's Bash tool (no tty) can use exec too
tty_flags() {
  local f=
  [ -t 0 ] && f+=' -i'
  [ -t 1 ] && f+=' -t'
  echo "$f"
}

case "${1:-}" in
  up)    up ;;
  down)  podman rm -f "$NAME" >/dev/null 2>&1 || true ;;
  ports) ports ;;
  exec)
    shift
    up
    # shellcheck disable=SC2046
    exec podman exec $(tty_flags) -w "$PWD" \
      -e TERM="${TERM:-xterm-256color}" \
      "$NAME" zsh -c "$*"
    ;;
  *)
    up
    exec podman exec -it -w "$PWD" \
      -e TERM="${TERM:-xterm-256color}" \
      -e COLORTERM="${COLORTERM:-}" \
      "$NAME" claude --permission-mode "$MODE" "$@"
    ;;
esac
